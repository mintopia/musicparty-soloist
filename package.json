{
  "name": "@mintopia/musicparty-soloist",
  "version": "1.0.0",
  "description": "Authenticating WebSocket proxy + supervisor for Spotify Soloist.",
  "license": "MIT",
  "author": "Jessica Smith <jess@mintopia.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintopia/musicparty-soloist.git"
  },
  "homepage": "https://github.com/mintopia/musicparty-soloist#readme",
  "bugs": "https://github.com/mintopia/musicparty-soloist/issues",
  "type": "module",
  "bin": {
    "soloist-proxy": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\"",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "test": "npm run build && node dist/selftest.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vue": "^3.5.18"
  }
}

# Copy to .env and fill in. docker-compose reads this via env_file (format: raw),
# so values are taken LITERALLY — paste keys exactly, even ones containing '$'.
# .env is gitignored — never commit real secrets.

# Spotify API Key passed to Soloist (--api-key). Required.
SOLOIST_API_KEY=

# Auth Token gating the Proxy (Bearer header or ?token=). Required.
PROXY_TOKEN=

# Optional overrides (defaults baked into the image):
# SOLOIST_DEVICE_NAME=Music Party
# SNAPCAST_STREAM=Spotify

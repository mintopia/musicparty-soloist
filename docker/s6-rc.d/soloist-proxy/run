#!/command/with-contenv sh
# Soloist supervisor + auth Proxy. s6 restarts this longrun if it exits.
# When an audio route is configured, wait for the null-sink's ports before launching
# Soloist with --pipewire-device (wait-for-sink no-ops when the var is empty).
cd /app
wait-for-sink "$SOLOIST_PIPEWIRE_DEVICE"
exec python -m soloist_proxy

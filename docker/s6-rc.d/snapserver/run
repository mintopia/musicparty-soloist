#!/command/with-contenv sh
# Snapserver (ticket 07): captures the soloist-sink null-sink via its native
# pipewire:// source (ADR-0002) and serves the stream to LAN Snapclients. Runs on
# host networking (see docker-compose) so clients reach it on 1704/1705.
#
# Render snapserver.conf from the Config File's stream_name. Fall back to the
# SNAPCAST_STREAM env / default if load_config raises (it validates the Proxy
# secrets, which the stream name itself doesn't need) so a secrets gap doesn't
# take the audio server down with it.
name=$(cd /app && node -e 'import("./dist/config.js").then(m=>process.stdout.write(String(m.loadConfig().streamName))).catch(()=>process.exit(1))' 2>/dev/null) \
  || name="${SNAPCAST_STREAM:-Spotify}"

wait-for-sink soloist-sink

cat > /etc/snapserver.conf <<EOF
[stream]
source = pipewire://?name=${name}&sampleformat=48000:16:2&codec=flac&capture_sink=true&target=soloist-sink

[http]
enabled = true
bind_to_address = 0.0.0.0
port = 1780
doc_root = /usr/share/snapserver/snapweb
EOF

exec snapserver -c /etc/snapserver.conf

#!/command/with-contenv sh
# Snapserver (ticket 07): captures the soloist-sink null-sink via its native
# pipewire:// source (ADR-0002) and serves the stream to LAN Snapclients. Runs on
# host networking (see docker-compose) so clients reach it on 1704/1705.
#
# Render snapserver.conf from the Config File's stream_name (ADR-0010: no env).
# Fall back to the "Spotify" default if load_config raises (e.g. the Proxy has not
# seeded /config yet, or a config error) so a config gap doesn't take the audio
# server down with it.
name=$(cd /app && node -e 'import("./dist/config.js").then(m=>process.stdout.write(String(m.loadConfig("/config/config.yaml").streamName))).catch(()=>process.exit(1))' 2>/dev/null) \
  || name="Spotify"

wait-for-sink soloist-sink

# The Proxy owns all fan-out links (ADR-0011): it links soloist-sink:monitor to
# this capture node when Snapcast is an enabled Audio Output. Snapserver just runs.

cat > /etc/snapserver.conf <<EOF
[stream]
source = pipewire://?name=${name}&sampleformat=48000:16:2&codec=flac&capture_sink=true&target=soloist-sink

[http]
enabled = true
bind_to_address = 0.0.0.0
port = 1780
doc_root = /usr/share/snapserver/snapweb
EOF

exec snapserver -c /etc/snapserver.conf
